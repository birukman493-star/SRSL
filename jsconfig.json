{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2020",
        "checkJs": false,
        "allowJs": true
    },
    "typeAcquisition": {
        "enable": true,
        "include": ["node", "express", "cookie-parser", "express-session", "bcryptjs"]
    },
    "include": ["**/*.js"],
    "exclude": ["node_modules", "tmp"]
}
